{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kensidian",
  "version": "1.3.0",
  "identifier": "app.kensidian.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kensidian",
        "width": 1200,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "maximized": true,
        "decorations": false,
        "shadow": true,
        "resizable": true,
        "visible": false,
        "backgroundColor": "#1e1e1e"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://api.github.com",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "publisher": "CandraSP",
    "shortDescription": "A lightweight Obsidian-style Markdown note-taking app",
    "longDescription": "Kensidian is a fast, lightweight Obsidian-style Markdown note-taking desktop application built with Tauri 2 and Vue 3, featuring local vault storage, offline-first design, and low memory footprint.",
    "copyright": "Copyright © 2026 CandraSP",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU3MDgxRERBRDM2MjE1N0EKUldSNkZXTFQyaDBJVnlvdHNCUjZpbVNFNXZESm5uai9xa25GaFZ4c2wrRU9md2hhSVM1Y1c2dVgK",
      "endpoints": [
        "https://github.com/candrasp/kensidian/releases/latest/download/latest.json"
      ]
    }
  }
}